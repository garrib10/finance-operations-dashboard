# FinTrack backend (Spring Boot). Local development template: copy to .env and use
# your own values. In staging and production these are Railway service variables.
# Placeholders only: never commit real secrets. Secrets are marked [secret].
# Every value here is backend-only; none may use a VITE_ prefix.
# See docs/deployment.md for the per-environment variable matrix.

# Database [secret password]. Differs per environment.
DB_URL=jdbc:mysql://localhost:3306/finance_operations_dashboard
DB_USERNAME=finance_user
DB_PASSWORD=your_local_database_password

# Railway sets SPRING_PROFILES_ACTIVE=prod (Secure cookies, no Swagger, quiet SQL).
# Leave it unset locally.
# SPRING_PROFILES_ACTIVE=prod

# Exact browser origins allowed to call the API, comma-separated. Origins only: no
# path, no trailing /api, no wildcard. Staging and production each list only their own
# Vercel frontend origin, e.g. https://fintrack-staging.example.com
FRONTEND_URLS=http://localhost:5173

# Access-token signing key [secret], Base64, unique per environment.
JWT_SECRET=your_base64_encoded_jwt_secret
# Access tokens last 5 minutes (300000 ms) in every environment.
JWT_EXPIRATION_MS=300000

# Refresh sessions. There is no refresh-token secret, hashing pepper, or cookie-domain
# setting: refresh tokens are opaque, stored only as SHA-256 hashes, and the cookie is
# HttpOnly (JavaScript can never read it) and host-only.
REFRESH_SESSION_TTL_SECONDS=2592000
# false only for local HTTP development. Staging and production: true (the default).
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_SESSION_CLEANUP_ENABLED=true
REFRESH_SESSION_RETENTION_DAYS=7

# Optional profile photos (Cloudinary) [secret API secret]. Leave disabled to run
# without a provider. Enable only with all values set. Use separate Cloudinary
# credentials and prefixes for production and nonproduction.
PROFILE_PHOTOS_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Example namespace: fintrack/development/profile-photos
PROFILE_PHOTO_KEY_PREFIX=
