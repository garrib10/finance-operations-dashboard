DB_URL=jdbc:mysql://localhost:3306/finance_operations_dashboard
DB_USERNAME=finance_user
DB_PASSWORD=your_local_database_password

JWT_SECRET=your_base64_encoded_jwt_secret
# Approved access-token lifetime is 300000 (5 minutes). Refresh is not wired yet
# (issue #18 phases 2+), so local development may temporarily use 3600000.
# Hosted environments must set 300000 when refresh-token support is released.
JWT_EXPIRATION_MS=300000

# Refresh sessions (backend only; never use VITE_). No refresh secret or pepper exists.
REFRESH_SESSION_TTL_SECONDS=2592000
# Local HTTP development only. Staging and production must use true (the default).
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_SESSION_CLEANUP_ENABLED=true
REFRESH_SESSION_RETENTION_DAYS=7

# Optional profile photos (Cloudinary). Leave disabled to run without a provider.
# Backend only: never use VITE_ for these values. Enable only with all values set.
PROFILE_PHOTOS_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Example namespace: fintrack/development/profile-photos
# Use separate provider environments/credentials for production and nonproduction.
PROFILE_PHOTO_KEY_PREFIX=
